# Babi Dental Analytics - configuration template.
# 1. Copy this file to ".env" (same folder) and edit the copy with a plain-text editor. NEVER commit or share ".env".
# 2. One KEY=value per line, no spaces around "=". Put comments on their own lines.
# 3. Wrap a value in "double quotes" if it contains spaces or a # character (for example a password).

# production = HTTPS required, Secure cookies (use this on a real server).
# local      = plain http://localhost for XAMPP / development.
# Any other value (or a typo) is treated as production on purpose.
APP_ENV=production

# Public address of the site. Must start with https:// in production. For XAMPP use the address you will type in the browser.
APP_URL=https://analytics.example.com

# Clinic time zone. Dates and times are stored and reported in this zone. Must be a valid PHP time zone name.
APP_TIMEZONE=Africa/Addis_Ababa

# Set to 1 ONLY when the site is behind a reverse proxy you control that sets X-Forwarded-Proto and appends the client address to X-Forwarded-For.
TRUST_PROXY=0

# Database connection (MySQL 8 or MariaDB 10.5+).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=babi_dental

# Runtime account used by the website: SELECT, INSERT, UPDATE, DELETE only.
DB_USER=babi_app
DB_PASS=change-me

# Account with DDL rights, used only by "php bin/migrate.php". Leave out of the .env on the live server once migrations are done.
DB_MIGRATE_USER=babi_migrate
DB_MIGRATE_PASS=change-me-too

# Optional: folder for session files. Must be writable by the web server and OUTSIDE the public web root.
# SESSION_PATH=/var/lib/babi/sessions
